{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "account-users": {
        "ClusterId": "account",
        "Match": {
          "Path": "/v1/users/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "preferences-catalog": {
        "ClusterId": "preferences",
        "Match": {
          "Path": "/v1/catalog"
        },
        "AuthorizationPolicy": "default"
      },
      "preferences-me": {
        "ClusterId": "preferences",
        "Match": {
          "Path": "/v1/preferences/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      }
    },
    "Clusters": {
      "account": {
        "Destinations": {
          "primary": {
            "Address": "http://account"
          }
        }
      },
      "preferences": {
        "Destinations": {
          "primary": {
            "Address": "http://preferences"
          }
        }
      }
    }
  }
}